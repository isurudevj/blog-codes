        "name": "stream_id",
        "query": {"query": "label_values(aeron_ipc_publisher_position_bytes, stream_id)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
